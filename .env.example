# Environment Variables for CSIT5970 Agent
# Copy this file to .env and fill in your actual API keys.

# ── LLM Provider API Keys ──────────────────────────────────────────────────
# At least one of these is required
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Optional: Override LLM model ──────────────────────────────────────────
# AGENT_MODEL=gpt-4o-mini       # Default: gpt-4o-mini (cost-effective)
# AGENT_MODEL=gpt-4o            # For higher quality responses
# AGENT_MODEL=claude-3-5-sonnet-20241022  # Anthropic alternative
